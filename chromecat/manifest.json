{
  "manifest_version": 3,
  "name": "Chrome Cat",
  "version": "1.0",
  "description": "Adds a movable sprite to walk around your screen.",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["motion.js", "sprite.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["tabs", "storage"],
  "web_accessible_resources": [
    {
      "resources": ["resources/**"],
      "matches": ["<all_urls>"]
    }
  ]
}
